# Copy to .env.local for local dev (or .env on the VPS) — never commit the real file.
# See HOSTING_HOSTINGER.md "Environment Variables Checklist" and SECURITY_CHECKLIST.md §7.

# Postgres connection string. Local dev example:
# postgresql://silvero:password@localhost:5432/silvero_dev
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Cashfree (Phase 2 — sandbox keys for local dev, live keys only on the VPS prod .env)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# Shiprocket (Phase 2)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
